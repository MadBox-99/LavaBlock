{
    "name": "LavaBlock",
    "version": "0.2.1",
    "title": "LavaBlock",
    "author": "Zoltán Tamás Szabó",
    "factorio_version": "2.0",
    "dependencies": [
        "base >= 2.0",
        "LavaBlock-graphics >= 0.2.0",
        "space-age",
        "! any-planet-start",
        "? Pyroclast"
    ],
    "package": {
        "git_publish_branch": "main",
        "ignore": [
            "*.bat",
            "**/*.bat",
            "*.ps1",
            "**/*.ps1",
            "*.exe",
            "**/*.exe",
            "*.sh",
            "**/*.sh",
            ".env",
            ".git/**",
            ".gitignore",
            ".editorconfig",
            ".claude/**",
            ".vscode/**",
            "node_modules/**",
            "package.json",
            "package-lock.json",
            "CLAUDE.md",
            "REVIEW.md",
            "docs/**",
            "tools/**",
            "space-age/**",
            "space-age-template.json",
            "runtime-api.json",
            "prototype-api.json"
        ]
    },
    "space_travel_required": true,
    "description": "You start on a small island surrounded by lava with no ore patches and no traditional mining. Everything is extracted from lava using chemical plants. Land can only be expanded through research. Requires Space Age."
}
